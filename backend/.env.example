PORT=5000
DATABASE_URL=postgresql://staynest:change-this-password@localhost:5432/staynest
PGSSL=false
# For migration, keep DATABASE_URL pointed at the source database.
# Copy these connection values from the Aiven service overview in the Aiven Console.
# AIVEN_HOST is the service host; AIVEN_PORT is its PostgreSQL port.
# AIVEN_DATABASE is the database name; AIVEN_USER and AIVEN_PASSWORD are its credentials.
# AIVEN_SSL_CA is the absolute path to the downloaded Aiven CA certificate.
# Keep DATABASE_URL pointed at the source until the migration is verified.
AIVEN_HOST=
AIVEN_PORT=
AIVEN_DATABASE=
AIVEN_USER=
AIVEN_PASSWORD=
AIVEN_SSL_CA=
# Alternatively, use AIVEN_DATABASE_URL instead of the five AIVEN connection fields.
# AIVEN_DATABASE_URL=
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret
API_URL=http://localhost:5000
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=StayNest <bookings@your-verified-domain.com>
INQUIRY_NOTIFY_EMAIL=support@your-domain.com
