app.get(
  "/api/apartments",
  wrap(async (req, res) => {
    const { q = "", city = "", min = "", max = "", guests = "" } = req.query;
    let sql = "SELECT * FROM apartments WHERE 1=1",
      args = [];
    if (q) {
      sql +=
        " AND (title ILIKE ? OR description ILIKE ? OR city ILIKE ? OR amenities::text ILIKE ?)";
      args.push(`%${q}%`, `%${q}%`, `%${q}%`, `%${q}%`);
    }
    if (city) {
      sql += " AND city ILIKE ?";
      args.push(`%${city}%`);
    }
    if (min) {
      sql += " AND price>=?";
      args.push(Number(min));
    }
    if (max) {
      sql += " AND price<=?";
      args.push(Number(max));
    }
    if (guests) {
      sql += " AND guests>=?";
      args.push(Number(guests));
    }
    sql += " ORDER BY featured DESC,created_at DESC";
    res.json({
      apartments: await db.prepare(sql).all(...args),
    });
  }),
);
